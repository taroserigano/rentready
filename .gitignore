# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ragas_cache/

# Secrets
.env

# Data stores
chroma_db/
storage/
uploads/
rentready.db
rentready.db.bak
rentready.e2e.db
backend/evals/results/*.json

# Trained model artifacts (regenerated via train_risk.py)
backend/artifacts/

# Phoenix
.phoenix/

# Node / React
node_modules/
frontend/dist/
frontend/.vite/

# Playwright e2e
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# OS
.DS_Store

# stale store copy
chroma_db.bad-readonly/

# Any .env backup/variant is still a secrets file (.env itself is covered
# above). Named explicitly because a bare `git add -A` would otherwise sweep
# something like .env.bak into a public repo.
.env.*
!.env.example

# Pulumi (infra/) -- local state, secrets passphrase, downloaded SSH key.
# Pulumi.dev.yaml is also excluded: it holds sshCidr (a real public IP) in
# plaintext, which shouldn't land in a public repo -- recreate it locally
# with `pulumi config set sshCidr <your-ip>/32` instead.
infra/venv/
infra/.pulumi-passphrase
infra/*.pem
infra/Pulumi.*.yaml
infra/Pulumi.*.yaml.bak
