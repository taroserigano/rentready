# ----------------------------------------------------------------------
# Copy this file to ".env" and fill in your keys:   cp .env.example .env
#
# The app RUNS without keys (mock LLM + offline embeddings fallback),
# so you can start it first and add real keys whenever you're ready.
# ----------------------------------------------------------------------

# --- Anthropic (the reasoning LLM) ------------------------------------
ANTHROPIC_API_KEY=
# Any Claude model your key has access to. List yours with:
#   curl https://api.anthropic.com/v1/models -H "x-api-key: $KEY" \
#        -H "anthropic-version: 2023-06-01"
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- LangSmith (tracing for the LangChain / graph side) ---------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rentready
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Arize Phoenix (local tracing for the LlamaIndex side) ------------
# Phoenix runs locally; no account needed. Leave default unless you host it.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Datadog (optional metric sink for the Monitoring tab) ------------
# Leave blank to disable. When set, the "Push to Datadog" button forwards
# live monitoring metrics (latency, violations, feedback) to Datadog.
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# --- Neo4j (the property graph) ---------------------------------------
# Local Podman default below. If using GCP / Aura, paste those values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=rentready123
NEO4J_DATABASE=neo4j

# --- Embeddings -------------------------------------------------------
# auto = try HuggingFace, fall back to offline if blocked
# huggingface = require the HF model | hash = always offline
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG knobs --------------------------------------------------------
RETRIEVER_K=4
# Income must be at least this multiple of monthly rent to qualify.
INCOME_RENT_MULTIPLE=3.0
# Minimum credit score to auto-qualify.
MIN_CREDIT_SCORE=620
